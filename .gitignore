# The virtual environment is built on your machine by setup_venv.bat. It is
# specific to your operating system and Python version, so it is not stored in
# git. Rebuild it any time with setup_venv.bat.
.venv/

# Generated report files.
output/

# Packaged zip artifacts (rebuildable).
dist/

# Python cache and test cache.
__pycache__/
*.pyc
.pytest_cache/

# Real equipment logs must never be committed. The bench machine's logs reach
# this project as pictures, deliberately: they are customer data and there is no
# approved path out for the text. These patterns are a guard rail, not a policy.
# The policy is in docs/HANDOFF.md. tests/data holds hand-built samples only.
*.elog
*.evt
elog*.txt
*_elog.*
/logs/
/real_logs/
*.xlsx
*.xls
# The sample and fixture files are the deliberate exceptions.
!tests/data/*.csv
!tests/browser/fixtures/*
