# The virtual environment is built on your machine by setup_venv.bat. It is
# specific to your operating system and Python version, so it is not stored in
# git. Rebuild it any time with setup_venv.bat.
.venv/

# Generated report files.
output/

# Packaged zip artifacts (rebuildable).
dist/

# Python cache and test cache.
__pycache__/
*.pyc
.pytest_cache/

# Vendor equipment manuals. They are fetched into
# projects/fab_drivers/manuals/ and read there. They are not committed, because
# they are the manufacturers' copyrighted documents and some of them are large.
# Each driver's PROTOCOL.md names its manual and records the file hash instead.
projects/fab_drivers/manuals/*.pdf
projects/fab_drivers/manuals/**/*.pdf
projects/fab_drivers/manuals/*.zip
